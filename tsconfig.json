{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "desktop/agent",
    "resolveJsonModule": true
  },
  "include": ["desktop/agent"],
  "exclude": ["desktop/agent/jarvis/plugins/*/skills"]
}
