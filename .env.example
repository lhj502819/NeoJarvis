ANTHROPIC_API_KEY=your-api-key-here
EVEROS_API_KEY=your-everos-api-key-here

# ── LLM 本地网关覆盖(pi-models 桥接,优先于 ~/.claude/settings.json)──
# JARVIS_LLM_BASE_URL=http://japi-ai-proxy.jd.com/aiProxy
# JARVIS_LLM_TOKEN=token#xxxx
# JARVIS_LLM_MODEL=DeepSeek-V4.1-Flash-A

# ── Watchdog(docs/superagent-design.md §2,均为可选)──
# JARVIS_WATCHDOG_INTERVAL_MIN=5    # 巡检间隔(分钟)
# JARVIS_WATCHDOG_IDLE_MIN=10      # 无动静阈值(分钟)
# JARVIS_WATCHDOG_MAX_MIN=30       # 总时长上限(分钟)
# JARVIS_QUIET_START_HOUR=23       # 免打扰开始(时)
# JARVIS_QUIET_END_HOUR=8          # 免打扰结束(时)
# JARVIS_PROACTIVE_HOURLY_CAP=3    # 每小时主动消息上限

# ── 事件系统(§3)──
# JARVIS_MORNING_REPORT_AT=09:00   # 晨报时间("HH:MM",留空停用)
# JARVIS_JDSME_CONFIG=...          # 京ME凭证路径(默认复用 task-hud 的 jdsme.json)
# 京ME 群白名单见 data/jarvis-events.json:{"groups":["群号"]}
